<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.medidispatch</groupId>
        <artifactId>medidispatch</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>dispatch-service</artifactId>

    <properties>
        <!-- written once, used by the BOM import and by the Spring Boot plugin below -->
        <spring-boot.version>4.1.1</spring-boot.version>
        <!-- keep method parameter names in the compiled code, so Spring can match {id} in a URL to a parameter "id" -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot's tested list of library versions (a BOM); it adds no code by itself -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- our engine -->
        <dependency>
            <groupId>com.medidispatch</groupId>
            <artifactId>dispatch-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- controllers, the built-in Tomcat web server, JSON; the version comes from the BOM -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- JdbcClient, for the database adapters. The plain library, not the Boot starter: the starter would make
             Boot create a DataSource at startup, and the app does not use the database until EngineConfig switches -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <!-- JUnit, AssertJ, Mockito and MockMvc, for tests only -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Database, for tests only until the adapters arrive (then Flyway and the driver move to the main scope). -->
        <!-- Flyway: runs the numbered SQL files in src/main/resources/db/migration, each exactly once, in order -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Flyway's PostgreSQL support (a separate jar since Flyway 10) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- the JDBC driver: how Java talks to Postgres -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- starts a throwaway Postgres in Docker for a test, and removes it afterwards -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- packages the app as one runnable jar, and adds "mvn spring-boot:run" -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>