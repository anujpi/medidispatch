<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.medidispatch</groupId>
        <artifactId>medidispatch</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>dispatch-service</artifactId>

    <properties>
        <!-- written once, used by the BOM import and by the Spring Boot plugin below -->
        <spring-boot.version>4.1.1</spring-boot.version>
        <!-- keep method parameter names in the compiled code, so Spring can match {id} in a URL to a parameter "id" -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot's tested list of library versions (a BOM); it adds no code by itself -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- our engine -->
        <dependency>
            <groupId>com.medidispatch</groupId>
            <artifactId>dispatch-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- real roads: the Bangalore road graph, A* and the traffic model (RoadTravelTime) -->
        <dependency>
            <groupId>com.medidispatch</groupId>
            <artifactId>dispatch-routing</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- tests only: the simulator drives this service over HTTP in an end-to-end test (SimulatorOverHttpTest).
             Test scope, and only this direction: this module is packaged as a Spring Boot jar, which other modules
             cannot load classes from. -->
        <dependency>
            <groupId>com.medidispatch</groupId>
            <artifactId>dispatch-sim</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- controllers, the built-in Tomcat web server, JSON; the version comes from the BOM -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Database: JPA (Hibernate + Spring Data JPA) and, inside it, plain JDBC (JdbcClient) and the HikariCP
             connection pool. With this starter Boot connects to the database at startup (spring.datasource.*). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Flyway: runs the numbered SQL files in src/main/resources/db/migration at startup, each exactly once, in
             order. Boot 4 needs this starter: flyway-core alone on the classpath no longer runs anything. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Flyway's PostgreSQL support (a separate jar since Flyway 10) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- the JDBC driver: how Java talks to Postgres. runtime: our code never names its classes -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- JUnit, AssertJ, Mockito and MockMvc, for tests only -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @DataJpaTest: starts only the JPA part of Spring, each test rolled back -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- starts a throwaway Postgres in Docker for the tests, and removes it afterwards -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- packages the app as one runnable jar, and adds "mvn spring-boot:run" -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>